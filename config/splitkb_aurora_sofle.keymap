#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/* Layer definitions */
#define QWERTY 1
#define LWR  2
#define RSE  3

/ {
    behaviors {
        n_save: n_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp W>, <&kp RET>;
        };
        n_close: n_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp Q>, <&kp RET>;
        };
        n_hsplit: n_hsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp S>, <&kp P>, <&kp RET>;
        };
        n_vsplit: n_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp V>, <&kp S>, <&kp P>, <&kp RET>;
        };
        td_lshft: tap_dance_lshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
        td_rshft: tap_dance_rshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp CAPS>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK Layer (default)";
            bindings = <

//+---------|---------|---------|---------|---------|---------+                          +-----------|---------|---------|---------|---------|---------+
    &gresc    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                                &kp N6      &kp N7    &kp N8    &kp N9    &kp N0   &kp EQUAL
//|---------|---------|---------|---------|---------|---------|                          |-----------|---------|---------|---------|---------|---------|
    &kp TAB    &kp Q     &kp W     &kp F     &kp P     &kp B                                 &kp J      &kp L     &kp U     &kp Y   &kp SEMI   &kp SQT
//|---------|---------|---------|---------|---------|---------|                          |-----------|---------|---------|---------|---------|---------|
   &kp BSPC    &kp A     &kp R     &kp S     &kp T     &kp G                                 &kp M      &kp N     &kp E     &kp I     &kp O    &kp RET
//|---------|---------|---------|---------|---------|---------|------------+-------------|-----------|---------|---------|---------|---------|---------|
   &td_lshft   &kp Z     &kp X     &kp C     &kp D     &kp V     &kp C_MUTE     &none        &kp K      &kp H   &kp COMMA  &kp DOT  &kp FSLH  &td_rshft
//+---------|---------|---------|---------|---------|---------|------------|-------------|-----------|---------|---------|---------|---------|---------+
                       &kp LALT  &kp LCTRL &kp LGUI  &kp SPACE &lt LWR UNDER &lt RSE MINUS &kp SPACE  &kp RCTRL &kp RALT    &none
//                    +---------|---------|---------|---------|------------+-------------|-----------|---------|---------|---------+
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        qwerty_layer {
            display-name = "QWERTY Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
    &trans    &trans    &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &trans     &kp Q     &kp W     &kp E     &kp R     &kp T                         &kp Y     &kp U     &kp I     &kp O     &kp P    &trans
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &trans     &kp A     &kp S     &kp D     &kp F     &kp G                         &kp H     &kp J     &kp K     &kp L   &kp SEMI   &trans
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
    &trans     &kp Z     &kp X     &kp C     &kp V     &kp B    &trans    &trans     &kp N     &kp M   &kp COMMA  &kp DOT  &kp FSLH   &trans
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans   &kp RALT
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
     &none     &none     &none   &kp NUHS    &none     &none                         &kp F7    &kp F8    &kp F9   &kp F10   &kp F11   &kp F12
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
     &none  &tog QWERTY  &none     &none     &none     &none                         &none     &none     &none     &none     &none     &none
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &kp DEL    &none     &none     &none     &none     &none                         &none   &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT   &none
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
    &trans   &kp TILDE   &none     &none     &none   &bt BT_CLR  &none     &none   &kp CARET &kp AMPS  &kp STAR  &kp PIPE  &kp BSLH    &trans
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                         &trans   &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                         &none     &none     &none     &none     &none     &none
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
     &none   &n_close   &n_save    &none     &none     &none                         &none     &none   &n_vsplit   &none     &none     &none
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
   &kp LBRC  &kp LBKT  &kp LPAR  &kp RPAR  &kp RBKT  &kp RBRC                      &n_hsplit &kp LC(H) &kp LC(J) &kp LC(K) &kp LC(L)   &none
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
    &trans   &kp EXCL   &kp AT   &kp HASH  &kp DLLR  &kp PRCNT   &none     &none     &none     &none     &none     &none     &none    &trans
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };
    };
};
