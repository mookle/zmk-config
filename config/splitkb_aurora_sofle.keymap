#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer definitions */
#define EXP 1
#define QWERTY 2
#define KRITA 3
#define LWR  4
#define RSE  5

#define XXX &none
#define ___ &trans

#define SPC_LWR &lt LWR SPACE
#define SPC_RSE &lt RSE SPACE

&lt {
    flavor = "balanced";
    tapping-term-ms = <190>; /* time until a pressed key is considered a hold */
    quick-tap-ms = <175>; /* repeats within this time will always yield a tap */
    //require-prior-idle-ms = <150>; /* always yield a tap if the last keypress was under this time */
};

/* Krita keybinds */
#define PICKER &kp LCTRL
#define ERASER &kp E
#define BRUSH &kp B
#define TRNSFRM &kp LC(T)
#define DESELECT &kp LC(LS(A))
#define LASSO &kp S
#define OPAC_UP &kp O
#define OPAC_DWN &kp I
#define MIRROR &kp M
#define UNDO &kp K_UNDO
#define REDO &kp K_REDO
#define ZOOM_IN &kp LC(PLUS)
#define ZOOM_OUT &kp LC(MINUS)
#define ROTATE &kp LCTRL
#define PAN &mkp MCLK

/* Bluetooth profile selectors */
#define BT_1 &bt BT_SEL 0
#define BT_2 &bt BT_SEL 1
#define BT_3 &bt BT_SEL 2
#define BT_4 &bt BT_SEL 3
#define BT_5 &bt BT_SEL 4

/ {
    behaviors {
        n_save: n_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp W>, <&kp RET>;
        };
        n_close: n_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp Q>, <&kp RET>;
        };
        n_hsplit: n_hsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp S>, <&kp P>, <&kp RET>;
        };
        n_vsplit: n_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp V>, <&kp S>, <&kp P>, <&kp RET>;
        };
        td_lshft: tap_dance_lshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
        td_rshft: tap_dance_rshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp CAPS>;
        };
        bs_del: backspace_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        quotes: combined_quotes {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        num_at: number_line_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp SINGLE_QUOTE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        num_hash: number_line_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp NUHS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK Layer (default)";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
    &gresc    &kp N1    &num_at  &num_hash  &kp N4    &kp N5                        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0   &kp EQUAL
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &kp TAB    &kp Q     &kp W     &kp F     &kp P     &kp B                         &kp J     &kp L     &kp U     &kp Y   &kp SEMI   &quotes
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &bs_del    &kp A     &kp R     &kp S     &kp T     &kp G                         &kp M     &kp N     &kp E     &kp I     &kp O    &kp RET
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
   &td_lshft   &kp Z     &kp X     &kp C     &kp D     &kp V  &kp C_MUTE    XXX      &kp K     &kp H   &kp COMMA  &kp DOT  &kp FSLH  &td_rshft
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                       &kp LALT  &kp LCTRL &kp LGUI   SPC_LWR  &kp UNDER &kp MINUS  SPC_RSE  &kp RGUI  &kp RCTRL &kp RALT
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        experimental_layer {
            display-name = "Experimental Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
      ___       ___       ___       ___       ___       ___                           ___       ___       ___       ___       ___       ___
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___       ___       ___       ___       ___       ___                           ___       ___       ___       ___       ___       ___
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___       ___       ___       ___       ___       ___                           ___       ___       ___       ___       ___       ___
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
      ___       ___       ___       ___       ___       ___       ___       ___       ___       ___       ___       ___       ___       ___
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                          ___       ___       ___       ___       ___       ___       ___       ___       ___       ___
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };

        qwerty_layer {
            display-name = "QWERTY Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
      ___       ___       ___       ___       ___       ___                           ___       ___       ___       ___       ___       ___
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___      &kp Q     &kp W     &kp E     &kp R     &kp T                         &kp Y     &kp U     &kp I     &kp O     &kp P     ___
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___      &kp A     &kp S     &kp D     &kp F     &kp G                         &kp H     &kp J     &kp K     &kp L   &kp SEMI    ___
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
      ___      &kp Z     &kp X     &kp C     &kp V     &kp B      ___       ___      &kp N     &kp M   &kp COMMA  &kp DOT  &kp FSLH    ___
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                          ___       ___       ___       ___       ___       ___       ___       ___       ___    &kp RALT
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };

        krita_layer {
            display-name = "Krita Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
      ___       XXX       XXX       XXX       XXX       XXX                           XXX       XXX       XXX       XXX       XXX       XXX
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___    OPAC_DWN   OPAC_UP   ERASER     BRUSH    TRNSFRM                         XXX       XXX       XXX       XXX       XXX       XXX
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      ___     MIRROR     LASSO   DESELECT   ZOOM_IN  ZOOM_OUT                         XXX       XXX       XXX       XXX       XXX       XXX
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
      ___   &kp K_UNDO &kp K_REDO PICKER    ROTATE      PAN       ___       XXX       XXX       XXX       XXX       XXX       XXX       XXX
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                          ___       ___       ___       ___       ___       XXX       XXX       XXX       XXX       XXX
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
            sensor-bindings = <&inc_dec_kp LBKT RBKT &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
      XXX       XXX       XXX    &kp HASH     XXX       XXX                          &kp F7    &kp F8    &kp F9   &kp F10   &kp F11   &kp F12
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      XXX   &tog QWERTY &tog EXP &tog KRITA   XXX       XXX                           XXX       XXX       XXX       XXX       XXX       XXX
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
    &kp DEL     XXX    &kp NUBS  &kp NUHS  &kp APOS     XXX                           XXX    &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT    XXX
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
      ___    &kp TILDE    XXX       XXX       XXX       XXX       XXX       XXX    &kp CARET &kp AMPS  &kp STAR  &kp PIPE  &kp NUBS     ___
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                          ___       ___       ___       ___       ___       ___       ___       ___       ___       ___
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
//+---------|---------|---------|---------|---------|---------+                   +---------|---------|---------|---------|---------|---------+
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                         BT_1      BT_2      BT_3      BT_4      BT_5   &bt BT_CLR
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
      XXX    &n_close   &n_save     XXX       XXX       XXX                           XXX       XXX    &n_vsplit    XXX       XXX       XXX
//|---------|---------|---------|---------|---------|---------|                   |---------|---------|---------|---------|---------|---------|
   &kp LBKT  &kp LPAR  &kp LBRC  &kp RBRC  &kp RPAR  &kp RBKT                      &n_hsplit &kp LC(H) &kp LC(J) &kp LC(K) &kp LC(L)    XXX
//|---------|---------|---------|---------|---------|---------|---------+---------|---------|---------|---------|---------|---------|---------|
      ___    &kp EXCL &kp LS(SQT) &kp NUHS &kp DLLR  &kp PRCNT    XXX       XXX       XXX       XXX       XXX       XXX       XXX       ___
//+---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------|---------+
                          ___       ___       ___       ___       ___       ___       ___       ___       ___       ___
//                    +---------|---------|---------|---------|---------+---------|---------|---------|---------|---------+
            >;
        };
    };
};
