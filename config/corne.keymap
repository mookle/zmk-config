#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Layers
 */
#define DEFAULT 0
#define QWERTY  1
#define LOWER   2
#define RAISE   3
#define NUMS    4
#define NVIM    5

/*
 * Space layer mods
 */
#define SL_LWR &spl LOWER SPACE
#define SL_RSE &spl RAISE SPACE

/*
 * Bluetooth
 */
#define BT_L0 &bt BT_SEL 0
#define BT_L1 &bt BT_SEL 1
#define BT_L2 &bt BT_SEL 2
#define BT_L3 &bt BT_SEL 3
#define BT_L4 &bt BT_SEL 4

/*
 * Tap dance
 */
#define DANCE_TERM <180>

/*
 * Homerow mods
 * CAGS layout
 */
#define HM_A &lmt LCTRL A
#define HM_R &lmt LALT R
#define HM_S &lmt LGUI S
#define HM_T &lmb LSHFT T
#define HM_N &rmb RSHFT N
#define HM_E &rmt RGUI E
#define HM_I &rmt RALT I
#define HM_O &rmt RCTRL O
#define LHS <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>
#define RHS <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>

/ {
    behaviors {
        lmt: left_homerow_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HOMEROW_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = RHS;
        };
        rmt: right_homerow_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_HOMEROW_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = LHS;
        };
        lmb: left_homerow_mod_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HOMEROW_MOD_BALANCED";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <25>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = RHS;
        };
        rmb: right_homerow_mod_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_HOMEROW_MOD_BALANCED";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <25>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = LHS;
        };
        spl: space_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <30>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
        X_cut: x_cut_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "X_CUT_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp X>, <&kp LG(X)>;
        };
        C_copy: c_copy_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "C_COPY_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp C>, <&kp LG(C)>;
        };
        V_paste: v_paste_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "V_PASTE_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp V>, <&kp LG(V)>;
        };
        n_save: nvim_save {
            compatible = "zmk,behavior-macro";
            label = "NVIM_SAVE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp RET>;
        };
        n_close: nvim_close {
            compatible = "zmk,behavior-macro";
            label = "NVIM_CLOSE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp Q &kp RET>;
        };
        n_hsplit: nvim_hsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp S &kp P>;
        };
        n_vsplit: nvim_vsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp V &kp S &kp P>;
        };
        n_left: nvim_left {
            compatible = "zmk,behavior-macro";
            label = "NVIM_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp LEFT>;
        };
        n_down: nvim_down {
            compatible = "zmk,behavior-macro";
            label = "NVIM_DOWN";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp DOWN>;
        };
        n_up: nvim_up {
            compatible = "zmk,behavior-macro";
            label = "NVIM_UP";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp UP>;
        };
        n_right: nvim_right {
            compatible = "zmk,behavior-macro";
            label = "NVIM_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp RIGHT>;
        };
        n_hopen: nvim_hopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
        };
        n_vopen: nvim_vopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &gresc     &kp Q     &kp W     &kp F     &kp P     &kp B        &kp J     &kp L     &kp U     &kp Y   &kp SEMI   &kp SQT
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp BSPC    HM_A      HM_R      HM_S      HM_T      &kp G        &kp M     HM_N      HM_E      HM_I      HM_O     &kp RET
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp BSLH    &kp Z    &X_cut    &C_copy    &kp D   &V_paste       &kp K     &kp H   &kp COMMA  &kp DOT  &kp FSLH  &kp RA(N3)
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                 &mo NUMS   SL_LWR    &kp TAB     &kp MINUS  SL_RSE   &kp EQUAL
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        qwerty_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans     &kp S     &kp D     &kp F    &trans        &kp H     &kp J     &kp K     &kp L   &kp SEMI   &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans     &kp V     &kp B        &kp N     &kp M    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        lower_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6       &trans   &kp HOME  &kp PG_DN &kp PG_UP  &kp END   &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans   &sl NVIM   &trans       &trans   &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &kp CARET &kp AMPS  &kp STAR  &kp TILDE  &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        raise_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp LBRC  &kp LPAR  &kp LBKT  &kp RBKT  &kp RPAR  &kp RBRC    &bt BT_CLR   BT_L0     BT_L1     BT_L2     BT_L3     BT_L4
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp GRAVE &kp EXCL   &kp AT   &kp NUHS  &kp DLLR  &kp PRCNT     &trans    &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        number_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans       &trans    &kp N1    &kp N2    &kp N3   &kp RPAR  &kp LPAR
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans  &tog QWERTY &trans      &kp MINUS  &kp N4    &kp N5    &kp N6    &kp N0   &kp BSLH
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &kp PLUS   &kp N7    &kp N8    &kp N9    &kp DOT  &kp STAR
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans   &kp UNDER  &trans      &kp BSPC   &kp RET  &kp EQUAL
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        nvim_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans   &n_close   &n_save   &trans    &trans    &trans       &trans    &trans   &n_vsplit &n_vopen   &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hsplit  &n_left   &n_down    &n_up   &n_right    &none
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hopen   &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
    };
};
