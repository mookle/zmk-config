#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Layers
 */
#define DEFAULT 0
#define QWERTY  1
#define LOWER   2
#define RAISE   3
#define NUMS    4
#define NVIM    5

/*
 * Hold/mod-tap
 */
#define HT_LS &mht LOWER SPACE
#define HT_RB &mht RAISE BSPC
#define HT_SS &htt RSHFT SEMI
#define HT_SC &hth LSHFT CAPS

/*
 * Bluetooth
 */
#define BT_L0 &bt BT_SEL 0
#define BT_L1 &bt BT_SEL 1
#define BT_L2 &bt BT_SEL 2
#define BT_L3 &bt BT_SEL 3
#define BT_L4 &bt BT_SEL 4

/*
 * Tap dance
 */
#define DANCE_TERM <180>

/ {
    behaviors {
        mht: momentary_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOMENTARY_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <30>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
        htt: hold_tap_tap  {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        htb: hold_tap_balanced  {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_BALANCED";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <30>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        hth: hold_tap_hold  {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <100>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };
        X_cut: x_cut_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "X_CUT_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp X>, <&kp LG(X)>;
        };
        c_copy: c_copy_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "C_COPY_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp C>, <&kp LG(C)>;
        };
        v_paste: v_paste_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "V_PASTE_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = DANCE_TERM;
            bindings = <&kp V>, <&kp LG(V)>;
        };
        n_save: nvim_save {
            compatible = "zmk,behavior-macro";
            label = "NVIM_SAVE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp RET>;
        };
        n_close: nvim_close {
            compatible = "zmk,behavior-macro";
            label = "NVIM_CLOSE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp Q &kp RET>;
        };
        n_hsplit: nvim_hsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp S &kp P>;
        };
        n_vsplit: nvim_vsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp V &kp S &kp P>;
        };
        n_left: nvim_left {
            compatible = "zmk,behavior-macro";
            label = "NVIM_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp LEFT>;
        };
        n_down: nvim_down {
            compatible = "zmk,behavior-macro";
            label = "NVIM_DOWN";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp DOWN>;
        };
        n_up: nvim_up {
            compatible = "zmk,behavior-macro";
            label = "NVIM_UP";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp UP>;
        };
        n_right: nvim_right {
            compatible = "zmk,behavior-macro";
            label = "NVIM_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp RIGHT>;
        };
        n_hopen: nvim_hopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
        };
        n_vopen: nvim_vopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &mo NUMS    &kp Q     &kp W     &kp F     &kp P     &kp B        &kp J     &kp L     &kp U     &kp Y  &kp RA(N3) &kp EQUAL
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
     HT_SC     &kp A     &kp R     &kp S     &kp T     &kp G        &kp M     &kp N     &kp E     &kp I     &kp O     HT_SS
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans     &kp Z     &kp X     &kp C     &kp D     &kp V        &kp K     &kp H   &kp COMMA  &kp DOT  &kp FSLH  &kp RALT
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                 &kp LCTRL   HT_LS    &kp ESC      &kp RET    HT_RB   &kp RGUI
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        qwerty_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans     &kp S     &kp D     &kp F    &trans        &kp H     &kp J     &kp K     &kp L   &kp SEMI   &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans     &kp V     &kp B        &kp N     &kp M    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        lower_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans   &n_close   &n_save   &trans    &trans    &trans      &kp CARET &kp AMPS  &kp STAR   &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans   &mo NVIM   &trans    &trans    &trans    &trans      &kp MINUS &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &kp DQT
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6       &trans   &kp RBKT  &kp RPAR  &kp RBRC  &kp TILDE &kp PIPE
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans      &kp UNDER  &kp TAB   &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        raise_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp GRAVE &kp EXCL   &kp AT   &kp POUND &kp DLLR  &kp PRCNT   &bt BT_CLR   BT_L0     BT_L1     BT_L2     BT_L3     BT_L4
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &kp SQT   &trans    &trans    &trans    &trans   &kp PLUS      &trans    &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp BSLH   &trans   &kp LBRC  &kp LPAR  &kp LBKT   &trans       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans   &kp COLON     &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        number_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans       &trans    &kp N1    &kp N2    &kp N3   &kp RPAR  &kp LPAR
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans  &tog QWERTY &trans      &kp MINUS  &kp N4    &kp N5    &kp N6    &kp N0   &kp FSLH
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &kp PLUS   &kp N7    &kp N8    &kp N9    &kp DOT  &kp STAR
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &kp RET  &kp BSPC  &kp EQUAL
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        nvim_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans   &n_vsplit &n_vopen   &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hsplit  &n_left   &n_down    &n_up   &n_right    &none
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hopen   &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
    };
};
