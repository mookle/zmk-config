#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Layers */
#define DEFAULT 0
#define QWERTY  1
#define LOWER   2
#define RAISE   3
#define NUMS    4
#define NVIM    5 

/* Aliases */
#define LOSPC &lt LOWER SPACE
#define RSTAB &lt RAISE TAB
#define BT_L0 &bt BT_SEL 0
#define BT_L1 &bt BT_SEL 1
#define BT_L2 &bt BT_SEL 2
#define BT_L3 &bt BT_SEL 3
#define BT_L4 &bt BT_SEL 4

/ {
    behaviors {
        n_save: nvim_save {
            compatible = "zmk,behavior-macro";
            label = "NVIM_SAVE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp RET>;
        };
        n_close: nvim_close {
            compatible = "zmk,behavior-macro";
            label = "NVIM_CLOSE";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp Q &kp RET>;
        };
        n_hsplit: nvim_hsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp S &kp P>;
        };
        n_vsplit: nvim_vsplit {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VSPLIT";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp V &kp S &kp P>;
        };
        n_left: nvim_left {
            compatible = "zmk,behavior-macro";
            label = "NVIM_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp LEFT>;
        };
        n_down: nvim_down {
            compatible = "zmk,behavior-macro";
            label = "NVIM_DOWN";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp DOWN>;
        };
        n_up: nvim_up {
            compatible = "zmk,behavior-macro";
            label = "NVIM_UP";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp UP>;
        };
        n_right: nvim_right {
            compatible = "zmk,behavior-macro";
            label = "NVIM_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp LC(W) &kp RIGHT>;
        };
        n_hopen: nvim_hopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_HOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
        };
        n_vopen: nvim_vopen {
            compatible = "zmk,behavior-macro";
            label = "NVIM_VOPEN";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &gresc     &kp Q     &kp W     &kp F     &kp P     &kp B        &kp J     &kp L     &kp U     &kp Y   &kp SEMI   &kp SQT
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp BSPC    &kp A     &kp R     &kp S     &kp T     &kp G        &kp M     &kp N     &kp E     &kp I     &kp O    &kp RET
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp LSHFT   &kp Z     &kp X     &kp C     &kp D     &kp V        &kp K     &kp H   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                 &kp LCTRL   LOSPC   &kp LGUI     &kp RALT    RSTAB     &none
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        qwerty_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans     &kp S     &kp D     &kp F    &trans        &kp H     &kp J     &kp K     &kp L   &kp SEMI   &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans     &kp V     &kp B        &kp N     &kp M    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        lower_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6       &trans    &kp HOME &kp PG_DN &kp PG_UP  &kp END   &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans   &mo NUMS   &trans    &trans   &sl NVIM   &trans       &trans   &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &kp CARET &kp AMPS  &kp STAR  &kp TILDE  &kp BSLH &kp EQUAL
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans   &kp UNDER  &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        raise_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
  &bt BT_CLR   BT_L0     BT_L1     BT_L2     BT_L3     BT_L4       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp LBRC  &kp LPAR  &kp LBKT  &kp RBKT  &kp RPAR  &kp RBRC      &trans    &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
   &kp GRAVE &kp EXCL   &kp AT   &kp NUHS  &kp DLLR  &kp PRCNT     &trans    &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans   &kp MINUS  &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        number_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans       &trans    &kp N1    &kp N2    &kp N3   &kp RPAR  &kp LPAR 
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans  &tog QWERTY &trans      &kp MINUS  &kp N4    &kp N5    &kp N6    &kp N0   &kp BSLH  
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &kp PLUS   &kp N7    &kp N8    &kp N9    &kp DOT  &kp STAR
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans   &kp UNDER  &trans      &kp BSPC   &kp RET  &kp EQUAL
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
        nvim_layer {
            bindings = <
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans   &n_close   &n_save   &trans    &trans    &trans       &trans    &trans   &n_vsplit &n_vopen   &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hsplit  &n_left   &n_down    &n_up   &n_right    &none
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
    &trans    &trans    &trans    &trans    &trans    &trans      &n_hopen   &trans    &trans    &trans    &trans    &trans
//|---------|---------|---------|---------|---------|---------|  |---------|---------|---------|---------|---------|---------|
                                  &trans    &trans    &trans       &trans    &trans    &trans
//                              |---------|---------|---------|  |---------|---------|---------|
            >;
        };
    };
};
